# ekklesia market configuration. Never commit real keys.
# The sandbox path writes .sandbox/env.sh from this contract id.
MARKET_CONTRACT_ID=ekklesia.testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional native sandbox URL; leave blank to let the near-kit pytest plugin
# manage Docker, or set http://127.0.0.1:3030 for a docker-run sandbox.
NEAR_SANDBOX_URL=
NEAR_AGENTS_FILE=.sandbox/agents.json

# Testnet signing for python -m magentic_marketplace.near.bootstrap:
# export NEAR_ACCOUNT_ID=ekklesia.testnet
# export NEAR_PRIVATE_KEY=ed25519:...
# Optional business payout account (must have a FullAccess key):
# NEAR_PAYOUT_ACCOUNT=ekklesia.testnet

# Optional Postgres backend (docker-compose.yaml provides it):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
